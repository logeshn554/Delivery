{
  "name": "delivery-super-app",
  "version": "1.0.0",
  "private": true,
  "description": "All-in-One Delivery & Mobility Super App",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema database/prisma/schema.prisma",
    "generate": "turbo run generate",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test:core": "node --test tests/*.test.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "build:api": "npm run build -w @delivery/api",
    "generate:db": "prisma generate --schema database/prisma/schema.prisma",
    "start:api": "npm run start -w @delivery/api",
    "dev:api": "npm run dev -w @delivery/api"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.4",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.14.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "database"
  ]
}
